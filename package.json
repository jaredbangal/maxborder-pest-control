{
  "name": "maxborder-pest-control",
  "version": "1.0.0",
  "private": true,
  "description": "Maxborder Pest Control \u2014 premium marketing site. React + Vite frontend, Node/Express API.",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "concurrently -n API,WEB -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client && node scripts/verify-csp-hashes.mjs",
    "start": "npm run start --workspace server",
    "lint": "npm run lint --workspace client",
    "typecheck": "npm run typecheck --workspace client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "dependencies": {
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "nodemailer": "^9.0.5",
    "zod": "^3.24.1"
  }
}
