# ---- Server ----
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Where the SQLite file lives (relative paths resolve from server/).
DATABASE_FILE=data/maxborder.db

# Long random string. Required to read leads from /api/admin/leads.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=

# Optional SMTP notifications for new leads. Leave blank to disable email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
LEAD_NOTIFY_TO=
LEAD_NOTIFY_FROM=

# ---- Client (build-time, must be prefixed VITE_) ----
# Leave blank in dev so Vite's proxy handles /api.
VITE_API_BASE_URL=
